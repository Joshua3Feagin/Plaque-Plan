{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "$amplify/env/agent": ["../.amplify/generated/env/agent.ts"],
      "$amplify/env/kbqa": ["../.amplify/generated/env/kbqa.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
