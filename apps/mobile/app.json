{
  "expo": {
    "name": "Plaque & Plan",
    "slug": "maxout",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "maxout",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#650030"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maxout.app"
    },
    "android": {
      "package": "com.maxout.app",
      "adaptiveIcon": {
        "backgroundColor": "#650030"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
