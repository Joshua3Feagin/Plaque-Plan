{
  "name": "maxout-dental-optimizer",
  "version": "1.0.0",
  "description": "Plaque & Plan Dental Benefits Optimizer - 24-hour hackathon build",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run web --workspace=apps/mobile",
    "demo": "npm run web --workspace=apps/mobile",
    "web": "npm run web --workspace=apps/mobile",
    "ios": "npm run ios --workspace=apps/mobile",
    "test": "npm run test --workspace=packages/engine",
    "build": "npm run build --workspaces",
    "sandbox": "npx ampx sandbox"
  },
  "keywords": ["dental", "benefits", "optimizer", "react-native", "aws", "amplify"],
  "author": "Team Plaque & Plan",
  "license": "MIT",
  "dependencies": {
    "aws-amplify": "^6.6.0",
    "@maxout/engine": "*",
    "@aws-sdk/client-bedrock-runtime": "^3.654.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@aws-amplify/backend": "^1.4.0",
    "@aws-amplify/backend-cli": "^1.2.9",
    "aws-cdk-lib": "^2.158.0",
    "constructs": "^10.3.0",
    "tsx": "^4.19.0",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "@babel/types": "^7.25.0",
    "@babel/generator": "^7.25.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}